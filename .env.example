# Copy to .env and change the values: cp .env.example .env
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=appdb

# 127.0.0.1 = only reachable from the server itself (use SSH tunnel)
# 0.0.0.0   = reachable on all server IPs, e.g. 192.168.18.8:337 (ufw does NOT block Docker ports)
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=337

POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
TZ=UTC

# pgAdmin web UI (open in browser via Cloudflare Tunnel, e.g. https://db.comshop.me.uk)
PGADMIN_EMAIL=admin@comshop.me.uk
PGADMIN_PASSWORD=change_me_pgadmin_password
PGADMIN_PORT=5050
