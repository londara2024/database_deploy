# Copy to .env and change the values: cp .env.example .env
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=appdb

# 127.0.0.1 = only reachable from the server itself (use SSH tunnel)
# 0.0.0.0   = reachable from the internet (restrict with ufw!)
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
TZ=UTC
